# ── VeraAI Web — Ortam Değişkenleri (şablon) ──
# Bu dosyayı .env olarak kopyala ve kendi değerlerini gir.
#   Windows:  copy .env.example .env

# ── Groq API (sohbet, görüş, ses) — https://console.groq.com ──
GROQ_API_KEY=

# Kullanılacak modeller
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ── OpenWeather API (canlı hava durumu) — https://openweathermap.org/api ──
OPENWEATHER_API_KEY=

# ── Seslendirme (edge-tts neural sesler) ──
TTS_VOICE_TR=tr-TR-EmelNeural
TTS_VOICE_EN=en-US-JennyNeural

# ── MySQL ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vera_db

# ── Flask ──
FLASK_SECRET_KEY=degistir-beni-guclu-bir-anahtarla
